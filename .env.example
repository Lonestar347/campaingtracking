# Copy to .env
DATABASE_URL="file:./dev.db"
# Storage root for uploaded files (relative to project root)
STORAGE_DIR="storage/uploads"
# Dev sign-in: default user if none is picked in the header (optional; else the first admin)
DEV_USER_EMAIL="anna.sample@example.com"

# --- Deployment (docker-compose.yml, see deploy/README.md) ---
# Public address; Caddy fetches the HTTPS certificate automatically
# DOMAIN="campaigns.example.com"
# Site-wide password (HTTP Basic Auth); leave unset locally
# BASIC_AUTH_USER="josera"
# BASIC_AUTH_PASSWORD=""
